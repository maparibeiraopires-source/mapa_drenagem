 ].map(x=>'<div class="stat"><b>'+x[1]+'</b><span>'+x[0]+'</span></div>').join("");
 let streetRows=Object.entries(streets).sort((a,b)=>b[1]-a[1]);
 $("summary").innerHTML=
 '<h3>Quantidade por logradouro</h3>'+(streetRows.length?'<table>'+streetRows.map(x=>'<tr><td>'+esc(x[0])+'</td><td>'+x[1]+'</td></tr>').join("")+'</table>':'—')+
 '<h3 style="margin-top:20px">Posição na rua</h3><div class="badges">'+Object.entries(pos).sort((a,b)=>b[1]-a[1]).map(x=>'<span class="badge">'+esc(x[0])+': <b>'+x[1]+'</b></span>').join("")+'</div>'+
 '<h3 style="margin-top:20px">Problemas e contagens</h3><div class="badges">'+Object.entries(probs).sort((a,b)=>b[1]-a[1]).map(x=>'<span class="badge">'+esc(x[0])+': <b>'+x[1]+'</b></span>').join("")+'</div>';
 $("cards").innerHTML=data.map((r,i)=>'<article class="card" data-id="'+esc(v(r,"id"))+'"><div class="card-head"><h3>'+esc(v(r,"id"))+' — '+esc(v(r,"logradouro"))+(v(r,"numero")?', nº '+esc(v(r,"numero")):'')+'</h3><span class="type">'+esc(v(r,"tipo")||"Cadastro")+'</span></div>'+
 '<div class="row"><b>Bairro</b><span>'+esc(v(r,"bairro")||"—")+'</span></div>'+
 '<div class="row"><b>Posição</b><span><span class="pos">'+esc(v(r,"posicao")||"Não informada")+'</span></span></div>'+
 '<div class="row"><b>Problema</b><span>'+esc(v(r,"problemas")||"Sem problema informado")+'</span></div>'+
 '<div class="row"><b>Observações</b><span>'+esc(v(r,"observacoes")||"—")+'</span></div>'+
 '<div class="row"><b>GPS</b><span class="coords">'+(r.lat_num??"—")+', '+(r.lon_num??"—")+'</span></div></article>').join("")||'<div class="card">Nenhum registro encontrado.</div>';
 if(!mapReady){initMap();mapReady=true}else{renderMap();}
