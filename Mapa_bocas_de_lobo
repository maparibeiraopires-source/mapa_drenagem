<style>
:root{--orange:#e87516;--orange2:#f59b45;--orange3:#fff1e3;--dark:#3a2112;--line:#eadfd5;--bg:#fffaf6;--white:#fff;--muted:#806f62}
*{box-sizing:border-box}body{margin:0;font-family:Montserrat,Arial,sans-serif;background:var(--bg);color:var(--dark)}
header{background:linear-gradient(135deg,#c9570c,#f18b2d);color:#fff;padding:26px 30px}
header h1{margin:0;font-size:26px;font-weight:800}header p{margin:7px 0 0;opacity:.9}
.toolbar{padding:16px 22px;background:#fff;display:flex;gap:9px;flex-wrap:wrap;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}
input,select,button{font:500 13px Montserrat,Arial;padding:11px 12px;border:1px solid #ddcfc3;border-radius:9px;background:#fff;color:var(--dark)}
input{min-width:300px}button{background:var(--orange);border-color:var(--orange);color:#fff;font-weight:700;cursor:pointer}
button:hover{background:#cf5e09}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;padding:18px 22px}
.stat{background:#fff;border:1px solid var(--line);border-radius:13px;padding:16px;box-shadow:0 3px 12px #6d371015}
.stat b{font-size:25px;font-weight:800;color:var(--orange);display:block}.stat span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.content{padding:0 22px 22px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 3px 12px #6d371015;overflow:hidden}
.section-title{padding:17px 19px;border-bottom:1px solid var(--line);font-weight:800;font-size:16px}
.summary{padding:18px}.summary h3{margin:0 0 10px;font-size:14px;color:var(--orange)}
table{width:100%;border-collapse:collapse}td{padding:8px 7px;border-bottom:1px solid #f0e7df;font-size:12px}td:last-child{text-align:right;font-weight:800}
.badges{display:flex;flex-wrap:wrap;gap:6px}.badge{padding:7px 9px;background:var(--orange3);border:1px solid #f5d2b2;border-radius:20px;font-size:11px}
.cards{padding:18px;display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px}
.card{border:1px solid var(--line);border-radius:13px;padding:15px;background:linear-gradient(180deg,#fff,#fffaf7);position:relative}
.card:hover{box-shadow:0 6px 20px #6d37101a;transform:translateY(-1px)}
.card-head{display:flex;justify-content:space-between;gap:10px;align-items:start;margin-bottom:12px}
.card h3{margin:0;font-size:14px;font-weight:800}.type{background:var(--orange);color:#fff;padding:5px 8px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap}
.row{display:grid;grid-template-columns:105px 1fr;gap:7px;padding:5px 0;border-bottom:1px solid #f3ebe4;font-size:11px}.row b{color:#8a7668}.row:last-child{border:0}
.coords{font-family:monospace;font-size:10px;color:#a35312}.pos{display:inline-block;padding:4px 7px;background:#fff0df;border-radius:6px;color:#a84f0b;font-weight:700}
.map-panel{margin-top:18px}.map-wrap{padding:18px;background:#fff}
#map{width:100%;height:480px;border:1px solid var(--line);border-radius:12px;background:#fff7ef;display:block}
.map-note{margin-top:9px;font-size:11px;color:var(--muted)}
.marker{cursor:pointer}.street-label{font-size:11px;font-weight:700;fill:#70401f}
@media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)}input{min-width:220px}.cards{grid-template-columns:1fr}}

#map{position:relative;width:100%;height:560px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#eee;cursor:grab;user-select:none}
#map.dragging{cursor:grabbing}
#mapTiles,#mapMarkers{position:absolute;inset:0;overflow:hidden}
#mapTiles{z-index:1;background:#eee}
#mapMarkers{z-index:2;pointer-events:none}
.map-tile{position:absolute;width:256px;height:256px;display:block;pointer-events:none}
.map-marker{position:absolute;width:18px;height:18px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 7px #0007;transform:translate(-50%,-50%);pointer-events:auto;cursor:pointer}
.map-marker:hover{transform:translate(-50%,-50%) scale(1.25);z-index:20}
.map-marker::after{content:"";position:absolute;inset:-7px;border-radius:50%;border:2px solid currentColor;opacity:.18}
.map-popup{position:absolute;z-index:50;min-width:240px;max-width:320px;background:#fff;border:1px solid #d9c6b7;border-radius:10px;padding:10px 12px;box-shadow:0 8px 25px #0003;font:500 11px Montserrat,Arial;color:var(--dark);pointer-events:auto}
.map-popup b{display:block;font-size:12px;margin-bottom:4px}
.map-popup .close{position:absolute;right:7px;top:4px;border:0;background:none;color:#7b6a5d;font-size:18px;padding:0;cursor:pointer}
#mapZoom{position:absolute;right:12px;top:12px;z-index:60;display:flex;flex-direction:column;gap:5px}
#mapZoom button{width:36px;height:36px;padding:0;border-radius:8px;background:#fff;color:var(--dark);border:1px solid #d9c6b7;box-shadow:0 2px 7px #0002;font-size:20px;line-height:1}
#mapZoom button:hover{background:#fff3e8}
#mapStatus{position:absolute;left:12px;bottom:12px;z-index:60;background:#fff;opacity:.94;border:1px solid #d9c6b7;border-radius:8px;padding:7px 10px;font-size:10px;color:#6d5c50;box-shadow:0 2px 7px #0002}
.map-compass{position:absolute;left:12px;top:12px;z-index:60;background:#fff;opacity:.94;border:1px solid #d9c6b7;border-radius:8px;padding:8px 10px;font-size:11px;font-weight:800;color:#9b4c0d;box-shadow:0 2px 7px #0002}
</style></head>
