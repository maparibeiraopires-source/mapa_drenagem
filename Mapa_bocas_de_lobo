let data=original.slice();
const $=id=>document.getElementById(id);
const colors=["#e4572e","#f28e2b","#f6aa4b","#c94c13","#e76f24","#ffb35c","#b83b0e","#d97706","#ef8a17","#9f4a16","#f4a261","#cc5500"];
let bairroColors={};
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function v(r,k){return r[k]===null||r[k]===undefined?"":String(r[k]).trim()}
function unique(k){return [...new Set(original.map(r=>v(r,k)).filter(Boolean))].sort((a,b)=>a.localeCompare(b,"pt-BR"))}
function fill(id,a){a.forEach(x=>$(id).insertAdjacentHTML("beforeend","<option>"+esc(x)+"</option>"))}
function counts(arr,k){let m={};arr.forEach(r=>{let x=v(r,k)||"Não informado";m[x]=(m[x]||0)+1});return m}
function filtered(){
 let q=$("search").value.toLowerCase();
 return original.filter(r=>
 (!q||["id","logradouro","numero","bairro","tipo","posicao","problemas","observacoes"].some(k=>v(r,k).toLowerCase().includes(q))) &&
 (!$("bairro").value||v(r,"bairro")===$("bairro").value)&&
 (!$("tipo").value||v(r,"tipo")===$("tipo").value)&&
 (!$("posicao").value||v(r,"posicao")===$("posicao").value)&&
 (!$("problema").value||v(r,"problemas").toLowerCase().includes($("problema").value.toLowerCase()))
 )}
function render(){
 data=filtered();
 const streets=counts(data,"logradouro"), probs=counts(data,"problemas"), pos=counts(data,"posicao");
 const boca=data.filter(r=>/boca/i.test(v(r,"tipo"))).length;
