function gpsCoord(r){
  function norm(raw, kind){
    let n=Number(raw);
    if(!Number.isFinite(n)) return null;
    let a=Math.abs(n);
    if(kind==="lat" && a>90) return n/(a<1e8?1e6:1e7);
    if(kind==="lon" && a>180) return n/(a<1e8?1e6:1e7);
    return n;
  }
  let lat=norm(r.latitude,"lat"), lon=norm(r.longitude,"lon");
  if(lat===null || lon===null || Math.abs(lat)>90 || Math.abs(lon)>180) return null;
  return {lat,lon};
}

let mapState={zoom:16,cx:0,cy:0,drag:false,sx:0,sy:0,ox:0,oy:0}; let mapReady=false;
const TILE=256;
const MAP_SERVERS=[
  zxy=>"https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/"+zxy.z+"/"+zxy.y+"/"+zxy.x,
  zxy=>"https://tile.openstreetmap.org/"+zxy.z+"/"+zxy.x+"/"+zxy.y+".png"
];
let tileServerIndex=0;

function lon2x(lon,z){return (lon+180)/360*Math.pow(2,z)}
function lat2y(lat,z){let r=lat*Math.PI/180;return (1-Math.log(Math.tan(r)+1/Math.cos(r))/Math.PI)/2*Math.pow(2,z)}
function x2lon(x,z){return x/Math.pow(2,z)*360-180}
function y2lat(y,z){let n=Math.PI-2*Math.PI*y/Math.pow(2,z);return 180/Math.PI*Math.atan(.5*(Math.exp(n)-Math.exp(-n)))}

function validPoints(){
  return data.map((r,i)=>{let p=gpsCoord(r);return p?{r,i,...p}:null}).filter(Boolean);
}

function fitMap(){
  let pts=validPoints();
  if(!pts.length)return;
  let lat=pts.reduce((s,p)=>s+p.lat,0)/pts.length;
  let lon=pts.reduce((s,p)=>s+p.lon,0)/pts.length;
  mapState.zoom=16;
  mapState.cx=lon2x(lon,mapState.zoom);
  mapState.cy=lat2y(lat,mapState.zoom);
}

function renderMap(){
  const map=$("map"), tiles=$("mapTiles"), markers=$("mapMarkers");
  if(!map||!tiles||!markers)return;
  tiles.innerHTML="";markers.innerHTML="";
  const pts=validPoints();
  if(!pts.length){$("mapStatus").textContent="Nenhum registro com coordenadas válidas.";return}
  const w=map.clientWidth,h=map.clientHeight,z=mapState.zoom,world=Math.pow(2,z);
  const left=mapState.cx*TILE-w/2,top=mapState.cy*TILE-h/2;
  const baseX=Math.floor(mapState.cx),baseY=Math.floor(mapState.cy);
  const cols=Math.ceil(w/TILE)+3,rows=Math.ceil(h/TILE)+3;

  for(let ty=baseY-Math.floor(rows/2)-1;ty<=baseY+Math.floor(rows/2)+1;ty++){
    for(let tx=baseX-Math.floor(cols/2)-1;tx<=baseX+Math.floor(cols/2)+1;tx++){
      let xx=((tx%world)+world)%world,yy=ty;
      if(yy<0||yy>=world)continue;
      let img=document.createElement("img");
      img.className="map-tile";img.draggable=false;img.alt="";
      img.style.left=(tx*TILE-left)+"px";img.style.top=(ty*TILE-top)+"px";
      img.src=MAP_SERVERS[tileServerIndex]({z,y:yy,x:xx});
      img.onerror=function(){
        if(tileServerIndex<MAP_SERVERS.length-1){tileServerIndex++;renderMap()}
      };
      tiles.appendChild(img);
    }
  }

  let bs=[...new Set(pts.map(p=>v(p.r,"bairro")).filter(Boolean))].sort();
  bs.forEach((b,i)=>bairroColors[b]=colors[i%colors.length]);

  pts.forEach(p=>{
    let px=lon2x(p.lon,z)*TILE-left,py=lat2y(p.lat,z)*TILE-top;
    if(px<-30||py<-30||px>w+30||py>h+30)return;
    let b=v(p.r,"bairro")||"Sem bairro",c=bairroColors[b]||"#777";
    let m=document.createElement("div");
    m.className="map-marker";m.style.left=px+"px";m.style.top=py+"px";m.style.background=c;m.style.color=c;
    m.title=v(p.r,"logradouro")+" • "+v(p.r,"tipo")+" • "+b;
    m.onclick=e=>{
      e.stopPropagation();
      document.querySelectorAll(".map-popup").forEach(x=>x.remove());
      let pop=document.createElement("div");pop.className="map-popup";
      pop.style.left=Math.min(Math.max(px+12,8),w-325)+"px";
      pop.style.top=Math.min(Math.max(py-95,8),h-155)+"px";
      pop.innerHTML='<button class="close">×</button><b>'+esc(v(p.r,"logradouro"))+', '+esc(v(p.r,"numero")||"s/n")+'</b>'+
        '<div>'+esc(v(p.r,"tipo"))+' • '+esc(v(p.r,"posicao")||"posição não informada")+'</div>'+
        '<div><strong>Bairro:</strong> '+esc(b)+'</div>'+
        '<div><strong>ID:</strong> '+esc(v(p.r,"id"))+'</div>'+
        '<div class="coords">'+p.lat.toFixed(7)+', '+p.lon.toFixed(7)+'</div>'+
        '<div style="margin-top:6px"><button class="go-card" style="padding:6px 8px;font-size:10px">Abrir cadastro</button></div>';
      pop.querySelector(".close").onclick=()=>pop.remove();
      pop.querySelector(".go-card").onclick=()=>{
        pop.remove();
        let card=[...document.querySelectorAll(".card")].find(c=>c.getAttribute("data-id")===v(p.r,"id"));
        if(card)card.scrollIntoView({behavior:"smooth",block:"center"});
      };
      map.appendChild(pop);
    };
    markers.appendChild(m);
  });
  $("mapStatus").textContent=pts.length+" ponto(s) • zoom "+z+" • cor por bairro";
}

function zoomMap(delta){
  let old=mapState.zoom,newz=Math.max(13,Math.min(19,old+delta));
  if(newz===old)return;
  let lon=x2lon(mapState.cx,old),lat=y2lat(mapState.cy,old);
  mapState.zoom=newz;mapState.cx=lon2x(lon,newz);mapState.cy=lat2y(lat,newz);
  renderMap();
}

function initMap(){
  fitMap();renderMap();
  $("zoomIn").onclick=()=>zoomMap(1);
  $("zoomOut").onclick=()=>zoomMap(-1);
  $("zoomFit").onclick=()=>{fitMap();renderMap()};
  const map=$("map");
  map.addEventListener("mousedown",e=>{
    if(e.target.closest(".map-marker,.map-popup,#mapZoom"))return;
    mapState.drag=true;mapState.sx=e.clientX;mapState.sy=e.clientY;mapState.ox=mapState.cx;mapState.oy=mapState.cy;map.classList.add("dragging");
  });
  window.addEventListener("mousemove",e=>{
    if(!mapState.drag)return;
    mapState.cx=mapState.ox-(e.clientX-mapState.sx)/TILE;
    mapState.cy=mapState.oy-(e.clientY-mapState.sy)/TILE;
    renderMap();
  });
  window.addEventListener("mouseup",()=>{mapState.drag=false;map.classList.remove("dragging")});
  map.addEventListener("wheel",e=>{e.preventDefault();zoomMap(e.deltaY<0?1:-1)},{passive:false});
  map.addEventListener("dblclick",e=>{e.preventDefault();zoomMap(1)});
  map.addEventListener("click",e=>{if(e.target===map)document.querySelectorAll(".map-popup").forEach(x=>x.remove())});
  window.addEventListener("resize",renderMap);
}

function clearFilters(){["search","bairro","tipo","posicao","problema"].forEach(id=>$(id).value="");render()}
function init(){fill("bairro",unique("bairro"));fill("tipo",unique("tipo"));fill("posicao",unique("posicao"));fill("problema",unique("problemas"));document.querySelectorAll("select,#search").forEach(x=>x.addEventListener("input",render));render()}
window.addEventListener("load",init);
</script></body></html>
